{
  "_comment": "Model catalog for the AI model launcher. Copy this file to models_local.json and replace with your own models. This file is .gitignored — edit freely.",
  "_schema": {
    "id":            "Unique slug — used as --served-model-name / llama.cpp --alias",
    "name":          "Display name shown in the TUI",
    "path":          "Absolute path to the model file or directory — any accessible location (local SSD, NAS, network share, etc.).",
    "format":        "One of: gguf | safetensors_bf16 | safetensors_fp16 | safetensors_fp8 | int8_bnb | exl2 | pytorch_bin",
    "ai_types":      "List of: text_gen | image_gen | embedding | speech",
    "ctx":           "Native context window in tokens — set to 0 for image generation models where this is not applicable",
    "size_gb":       "Approximate disk size in GB (used for VRAM fit warnings)",
    "params_m":      "(auto) Parameter count in millions, e.g. 70000 for 70B. Populated by ingest/refresh.",
    "arch":          "(auto) HF architecture class name, e.g. LlamaForCausalLM. Populated by ingest/refresh.",
    "moe_experts":   "(auto) Total routed expert count for MoE models; omit or 0 for dense models.",
    "moe_active":    "(auto) Experts active per token for MoE models; omit or 0 for dense models.",
    "vision":        "(auto) true if the model accepts image input. Populated by ingest/refresh.",
    "mmproj_path":   "(optional, gguf vision only) Absolute path to the companion mmproj-*.gguf vision encoder. Passed as --mmproj at launch time.",
    "quant":         "(optional) Quantisation label for display, e.g. Q4_K_M — mainly for GGUF",
    "ctx_override":  "(optional) Override the context length at launch time; 0 = use native ctx. Set with the 'l' key in the TUI.",
    "min_sm":        "(optional) Minimum CUDA compute capability required, e.g. 89 for sm_89+. 0 = no constraint.",
    "hw_note":       "(optional) Human-readable explanation shown when the model is incompatible with the current hardware.",
    "favorite":      "(optional) true to pin this model to the top of the list. Toggled with 'f' in the TUI.",
    "note":          "(optional) Free-text note shown in the TUI",
    "cached_path":   "(optional) Absolute path to a faster local copy. Set automatically by the TUI cache action.",
    "trust_remote_code": "(optional) true if servers must pass --trust-remote-code for this model.",
    "server_status": "(optional) Test results: {server_id: {environment_name: {quant_key: good|bad|unknown}}}. environment_name is a registered environment (environments.json). Updated by the TUI g/x/? keys.",
    "server_params": "(optional) Per-server parameter overrides merged on top of server defaults at launch time.",
    "comfyui_subdir": "(optional, image_gen only) ComfyUI models/ subdirectory to stage into. Default: 'checkpoints'. Use 'diffusion_models' for FLUX UNets.",
    "tool_call_parser": "(optional) vLLM tool-call parser name (e.g. 'openai', 'hermes', 'llama3_json'). When set, servers emit tool-calling flags automatically. Translated for SGLang."
  },
  "models": [
    {
      "id": "my-model-bf16",
      "name": "My Model 70B",
      "path": "/mnt/models/text-generation/My-Model-70B",
      "format": "safetensors_bf16",
      "ai_types": ["text_gen"],
      "ctx": 32768,
      "size_gb": 140,
      "note": "Example BF16 safetensors model"
    },
    {
      "id": "my-model-q4km",
      "name": "My Model 70B",
      "path": "/mnt/models/text-generation/My-Model-70B-GGUF/my-model-70b.Q4_K_M.gguf",
      "format": "gguf",
      "ai_types": ["text_gen"],
      "ctx": 32768,
      "size_gb": 42,
      "quant": "Q4_K_M"
    },
    {
      "id": "my-model-custom-vllm",
      "name": "My Model 7B (custom vLLM params)",
      "path": "/mnt/models/text-generation/My-Model-7B",
      "format": "safetensors_fp16",
      "ai_types": ["text_gen"],
      "ctx": 131072,
      "size_gb": 14,
      "server_status": {"vllm": {"vllm": {"none": "good"}}},
      "server_params": {
        "vllm": {
          "gpu_mem_util": 0.5,
          "tensor_parallel": 1,
          "pipeline_parallel": 1,
          "executor_backend": "mp"
        }
      }
    },
    {
      "id": "sdxl-base-fp16",
      "name": "Stable Diffusion XL Base 1.0",
      "path": "/mnt/models/image-generation/sd_xl_base_1.0.safetensors",
      "format": "safetensors_fp16",
      "ai_types": ["image_gen"],
      "ctx": 0,
      "size_gb": 6.5,
      "note": "Example SDXL checkpoint"
    },
    {
      "id": "flux-dev-bf16",
      "name": "FLUX.1-dev",
      "path": "/mnt/models/image-generation/flux1-dev.safetensors",
      "format": "safetensors_bf16",
      "ai_types": ["image_gen"],
      "ctx": 0,
      "size_gb": 24,
      "comfyui_subdir": "diffusion_models",
      "note": "Example FLUX.1 diffusion UNet — staged to ComfyUI models/diffusion_models/"
    }
  ]
}
