{
  "_comment": "Model catalog for the AI model launcher. Copy this file to models_local.json and replace with your own models. This file is .gitignored — edit freely.",
  "_schema": {
    "id":            "Slug used as --served-model-name / llama.cpp --alias. Copies of a model at other storage locations are separate entries with the same id; an entry is identified by (path, format).",
    "name":          "Display name shown in the TUI",
    "path":          "Absolute path to the model file or directory, inside one of the [[locations]] in config.toml.",
    "family":        "Shared by an original model and every copy, conversion and quantization of it. Assigned by ingest (slug of the name); inherited on copy/convert.",
    "format":        "One of: gguf | safetensors_bf16 | safetensors_fp16 | safetensors_fp8 | int8_bnb | exl2 | pytorch_bin",
    "ai_types":      "List of: text_gen | image_gen | embedding | speech",
    "ctx":           "Native context window in tokens — set to 0 for image generation models where this is not applicable",
    "size_gb":       "Approximate disk size in GB (used for VRAM fit warnings)",
    "params_m":      "(auto) Parameter count in millions, e.g. 70000 for 70B. Populated by ingest/refresh.",
    "arch":          "(auto) HF architecture class name, e.g. LlamaForCausalLM. Populated by ingest/refresh.",
    "moe_experts":   "(auto) Total routed expert count for MoE models; omit or 0 for dense models.",
    "moe_active":    "(auto) Experts active per token for MoE models; omit or 0 for dense models.",
    "vision":        "(auto) true if the model accepts image input. Populated by ingest/refresh.",
    "mmproj_path":   "(optional, gguf vision only) Absolute path to the companion mmproj-*.gguf vision encoder. Passed as --mmproj at launch time.",
    "mtp_path":      "(auto, gguf only) Absolute path to the companion mtp-*.gguf multi-token-prediction draft head. llama.cpp/ooba launch with --spec-type draft-mtp --model-draft <path> unless server param mtp is false.",
    "mtp_embedded":  "(auto) true when the model carries its own MTP layers: a GGUF's NextN layers, or an HF checkpoint declaring MTP layers in config.json that ships their weights. Used only when the server's mtp param is on for the model (llama.cpp/ooba: --spec-type draft-mtp; vLLM: --speculative-config).",
    "draft_path":    "(auto) Speculative draft companion: an HF draft checkpoint dir beside the model (e.g. <model>-DFlash2; vLLM --speculative-config) or a GGUF dspark-*/dflash-*.gguf sidecar in the bundle (llama.cpp --spec-type draft-dspark|draft-dflash). Used when the server's draft param is on.",
    "template_tools": "(auto) true when the chat template declares tools — enough for llama.cpp tool calling; vLLM/SGLang also need tool_call_parser.",
    "quant":         "(optional) Quantisation label for display, e.g. Q4_K_M — mainly for GGUF",
    "ctx_override":  "(optional) Override the context length at launch time; 0 = use native ctx (scaled by rope_scaling when set). Set with the 'l' key in the TUI.",
    "rope_scaling":  "(optional) RoPE context extension, e.g. {\"factor\": 4.0} for YaRN 256K → 1M; optional \"method\" (default yarn) and \"original_ctx\" (default ctx). Applied by llama.cpp, vLLM, SGLang and ooba (GGUF). Set with the 'l' key in the TUI.",
    "min_sm":        "(optional) Minimum CUDA compute capability required, e.g. 89 for sm_89+. 0 = no constraint.",
    "hw_note":       "(optional) Human-readable explanation shown when the model is incompatible with the current hardware.",
    "favorite":      "(optional) true to pin this model to the top of the list. Toggled with 'f' in the TUI.",
    "note":          "(optional) Free-text note shown in the TUI",
    "trust_remote_code": "(optional) true if servers must pass --trust-remote-code for this model.",
    "server_status": "(optional) Test results: {server_id: {environment_name: {quant_key: good|bad|unknown}}}. environment_name is a registered environment (environments.json). Updated by the TUI g/x/? keys.",
    "server_params": "(optional) Per-server parameter overrides merged on top of server defaults at launch time — editable on the model settings page, which lists every parameter with its help. Auto parameters (e.g. vllm expert_parallel) are omitted (or null) to stay auto.",
    "comfyui_subdir": "(optional, image_gen only) ComfyUI models/ subdirectory to stage into. Default: 'checkpoints'. Use 'diffusion_models' for FLUX UNets.",
    "tool_call_parser": "(optional) vLLM tool-call parser name (e.g. 'openai', 'hermes', 'llama3_json'). When set, servers emit tool-calling flags automatically. Translated for SGLang.",
    "reasoning_parser": "(optional) vLLM reasoning parser name (e.g. 'qwen3', 'deepseek_r1', 'glm45'). When set, vLLM and SGLang return the model's thinking separately as reasoning_content (names translated for SGLang).",
    "disabled_template_patches": "(optional) Chat template patch ids NOT to apply at launch (e.g. ['system_anywhere']). Every other patch matching the model's chat template is applied automatically via a patched copy. Toggled by the TUI t key."
  },
  "models": [
    {
      "id": "my-model-bf16",
      "name": "My Model 70B",
      "family": "my-model-70b",
      "path": "/mnt/models/text-generation/My-Model-70B",
      "format": "safetensors_bf16",
      "ai_types": ["text_gen"],
      "ctx": 32768,
      "size_gb": 140,
      "note": "Example BF16 safetensors model"
    },
    {
      "id": "my-model-q4km",
      "name": "My Model 70B",
      "family": "my-model-70b",
      "path": "/mnt/models/text-generation/My-Model-70B-GGUF/my-model-70b.Q4_K_M.gguf",
      "format": "gguf",
      "ai_types": ["text_gen"],
      "ctx": 32768,
      "size_gb": 42,
      "quant": "Q4_K_M"
    },
    {
      "id": "my-model-custom-vllm",
      "name": "My Model 7B (custom vLLM params)",
      "family": "my-model-7b",
      "path": "/mnt/models/text-generation/My-Model-7B",
      "format": "safetensors_fp16",
      "ai_types": ["text_gen"],
      "ctx": 131072,
      "size_gb": 14,
      "server_status": {"vllm": {"vllm": {"none": "good"}}},
      "server_params": {
        "vllm": {
          "gpu_mem_util": 0.5,
          "tensor_parallel": 1,
          "pipeline_parallel": 1,
          "executor_backend": "mp"
        }
      }
    },
    {
      "id": "sdxl-base-fp16",
      "name": "Stable Diffusion XL Base 1.0",
      "family": "stable-diffusion-xl-base-1-0",
      "path": "/mnt/models/image-generation/sd_xl_base_1.0.safetensors",
      "format": "safetensors_fp16",
      "ai_types": ["image_gen"],
      "ctx": 0,
      "size_gb": 6.5,
      "note": "Example SDXL checkpoint"
    },
    {
      "id": "flux-dev-bf16",
      "name": "FLUX.1-dev",
      "family": "flux-1-dev",
      "path": "/mnt/models/image-generation/flux1-dev.safetensors",
      "format": "safetensors_bf16",
      "ai_types": ["image_gen"],
      "ctx": 0,
      "size_gb": 24,
      "comfyui_subdir": "diffusion_models",
      "note": "Example FLUX.1 diffusion UNet — staged to ComfyUI models/diffusion_models/"
    }
  ]
}
