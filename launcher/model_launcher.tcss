/* model_launcher.tcss — Textual CSS for AI Model Launcher */

/* ── Global ─────────────────────────────────────────────────────────────── */
Screen {
    background: $surface;
    layers: base overlay;
}

Header {
    background: $primary-darken-2;
    color: $text;
}

Footer {
    background: $primary-darken-2;
}

/* ── GPU Table widget ────────────────────────────────────────────────────── */
GpuTable {
    height: auto;
    max-height: 16;
    border: round $primary-darken-1;
    margin: 0 1 1 1;
    padding: 0 1;
}

GpuTable DataTable {
    height: auto;
}

/* ── Main menu ───────────────────────────────────────────────────────────── */
#menu-title {
    margin: 0 1;
    text-style: bold;
    color: $accent;
}

#main-menu-buttons {
    margin: 0 1;
}

#main-menu-buttons Button {
    width: 100%;
    margin-bottom: 1;
}

#btn-quit {
    margin-top: 1;
}

/* ── Model-select screens ────────────────────────────────────────────────── */
#screen-title {
    margin: 0 1 1 1;
    text-style: bold;
    color: $accent;
}

#model-list {
    border: round $primary-darken-1;
    margin: 0 1;
    height: 1fr;
}

#model-table {
    margin: 0 1;
    height: 1fr;
}

#server-list,
#quant-list,
#tool-list,
#option-list {
    margin: 0 1;
    height: 1fr;
}

#status-bar {
    height: 1;
    margin: 0 1;
    background: $panel;
    color: $text-muted;
}

#status-bar-left {
    padding: 0 1;
    width: 1fr;
    height: 1;
}

#status-bar-right {
    padding: 0 1;
    width: auto;
    height: 1;
    text-align: right;
}

/* ── Confirm launch screen ───────────────────────────────────────────────── */
#confirm-body {
    margin: 1 2;
    height: 1fr;
}

#confirm-text {
    border: round $primary-darken-1;
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
    color: $text-muted;
}

#confirm-buttons {
    margin-top: 1;
    height: auto;
    align: center middle;
}

#confirm-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* ── Cache management screens ────────────────────────────────────────────── */
#cache-table {
    height: 1fr;
    margin: 0 1;
}

#storage-bar {
    height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#cache-status-label {
    margin: 0 1 1 1;
}

#cache-ops {
    margin: 0 1;
}

#cache-ops Button {
    width: 100%;
    margin-bottom: 1;
}

#cache-op-title {
    margin: 0 1 1 1;
    text-style: bold;
    color: $accent;
}

#cache-progress-bar {
    margin: 0 1 0 1;
    height: 1;
}

#cache-progress-detail {
    height: 1;
    margin: 0 1;
    text-align: right;
}

#cache-ops-status {
    height: 1;
    margin: 0 1;
}

#cache-op-buttons {
    height: auto;
    margin: 1 1 0 1;
    align: center middle;
}

/* ── GPU selection screen ────────────────────────────────────────────────── */
#gpu-list {
    margin: 0 1;
    height: 1fr;
    border: round $primary-darken-1;
}

#gpu-status {
    height: 2;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}
