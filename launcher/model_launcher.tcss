/* model_launcher.tcss — Textual CSS for AI Model Launcher */

/* ── Global ─────────────────────────────────────────────────────────────── */
Screen {
    background: $surface;
    layers: base overlay;
}

Header {
    background: $primary-darken-2;
    color: $text;
}

Footer {
    background: $primary-darken-2;
}

/* ── GPU Table widget ────────────────────────────────────────────────────── */
GpuTable {
    height: auto;
    max-height: 16;
    border: round $primary-darken-1;
    margin: 0 1 1 1;
    padding: 0 1;
}

GpuTable DataTable {
    height: auto;
}

/* ── Main menu ───────────────────────────────────────────────────────────── */
#menu-title {
    margin: 0 1;
    text-style: bold;
    color: $accent;
}

#main-menu-buttons {
    margin: 0 1;
}

#main-menu-buttons Button {
    width: 100%;
    margin-bottom: 1;
}

#btn-quit {
    margin-top: 1;
}

/* ── Model-select screens ────────────────────────────────────────────────── */
#screen-title {
    margin: 0 1 1 1;
    text-style: bold;
    color: $accent;
}

#model-list {
    border: round $primary-darken-1;
    margin: 0 1;
    height: 1fr;
}

#model-table {
    margin: 0 1;
    height: 1fr;
}

#server-list,
#env-list,
#env-manage-list,
#quant-list,
#tool-list,
#option-list {
    margin: 0 1;
    height: 1fr;
}

/* ── Model properties ────────────────────────────────────────────────────── */
#props-info {
    margin: 0 1 1 1;
    color: $text-muted;
}

#props-table {
    margin: 0 1;
    height: 1fr;
    /* As wide as its columns, so section heading bars span the whole table. */
    width: auto;
    max-width: 100%;
}

/* Section heading rows (Model, vLLM, llama.cpp, …) — a component class of the screen. */
ModelPropertiesScreen > .props--section {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

#props-help {
    height: auto;
    min-height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#env-detail {
    height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* Detail line under option pickers (runtime / offline quantization). */
#option-detail {
    height: auto;
    min-height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* ── Dialogs: choice / command run ───────────────────────────────────────── */
#choice-message {
    margin: 0 1 1 1;
}

#cmd-line {
    margin: 0 1;
}

#cmd-log {
    border: round $primary-darken-1;
    margin: 0 1;
    height: 1fr;
}

#cmd-status {
    margin: 0 1;
}

#status-bar {
    height: 1;
    margin: 0 1;
    background: $panel;
    color: $text-muted;
}

#status-bar-left {
    padding: 0 1;
    width: 1fr;
    height: 1;
}

#status-bar-right {
    padding: 0 1;
    width: auto;
    height: 1;
    text-align: right;
}

/* ── Confirm launch screen ───────────────────────────────────────────────── */
#confirm-body {
    margin: 1 2;
    height: 1fr;
}

#confirm-title {
    height: 1;
    margin-bottom: 1;
    color: $accent;
}

#confirm-command {
    border: round $primary-darken-1;
    padding: 1 2;
    height: 1fr;
}

#confirm-buttons {
    margin-top: 1;
    height: auto;
    align: center middle;
}

#confirm-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* ── Copy screens ─────────────────────────────────────────────────────────── */
#storage-bar {
    height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

#copy-status-label {
    margin: 0 1 1 1;
}

#copy-ops {
    margin: 0 1;
}

#copy-ops Button {
    width: 100%;
    margin-bottom: 1;
}

#copy-op-title {
    margin: 0 1 1 1;
    text-style: bold;
    color: $accent;
}

#copy-progress-bar {
    margin: 0 1 0 1;
    height: 1;
}

#copy-progress-detail {
    height: 1;
    margin: 0 1;
    text-align: right;
}

#copy-ops-status {
    height: 1;
    margin: 0 1;
}

#copy-op-buttons {
    height: auto;
    margin: 1 1 0 1;
    align: center middle;
}

/* ── GPU selection screen ────────────────────────────────────────────────── */
#gpu-list {
    margin: 0 1;
    height: 1fr;
    border: round $primary-darken-1;
}

#gpu-status, #gpu-fit {
    height: 2;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text;
}

#gpu-fit.-empty {
    display: none;
}
