# ─────────────────────────────────────────────────────────────────────────────
# Model Server Launcher — site configuration template
#
# Copy this file to config.toml and fill in your system's paths.
#   cp launcher/config.toml.example launcher/config.toml
#
# config.toml is .gitignored.  This example file is tracked.
# ~ and $VARS are expanded in all path values.
# ─────────────────────────────────────────────────────────────────────────────

[paths]

# Miniconda / Anaconda base directory.  Conda environments registered in
# user_data/environments.json are resolved under <conda_base>/envs/.
conda_base = "~/miniconda3"

# tabbyAPI entry point and the staging directory where model symlinks are created
tabby_main      = "~/tabbyAPI/main.py"
tabby_model_dir = "~/tabbyAPI/models"

# text-generation-webui (oobabooga) entry point and model staging directory
# ooba_model_dir is where the launcher creates per-launch model symlinks.
# It should match (or be inside) ooba's models directory so the UI can also browse them.
ooba_main       = "~/text-generation-webui/server.py"
ooba_model_dir  = "~/text-generation-webui/user_data/models"

# ComfyUI — path to main.py and base models directory.
# The launcher stages symlinks for every catalog image_gen model under comfyui_models_dir,
# organized by subdirectory (e.g. models/checkpoints/, models/diffusion_models/).
# A model stored at several locations is staged once, from the first online location in
# [[locations]] order.
comfyui_main      = "~/ComfyUI/main.py"
comfyui_models_dir = "~/ComfyUI/models"

# Path to the ExLlamaV2 convert.py script used for EXL2 quantization.
# If this file doesn't exist, the launcher falls back to -m exllamav2.conversion.convert_exl2
# (the module entrypoint for exllamav2 >= 0.3.x installed as a package).
exl2_convert_script = "~/exllamav2/convert.py"

# Python interpreter with PyTorch and Transformers for llama.cpp's
# convert_hf_to_gguf.py. Defaults to the Python running the launcher.
# A dedicated env keeps server envs' pins out of the way: new architectures
# often need a newer Transformers than a server env can take.
llama_convert_python = ""

# CUDA_HOME injected when launching tabbyAPI (needed for flash-attn)
# Leave empty ("") to skip setting it.
cuda_home_tabby  = "/usr/local/cuda-12.5"

# CUDA_HOME injected when launching SGLang (directs flashinfer JIT to the right nvcc).
# cuda-12.1 only supports gcc ≤ 12; use cuda-12.5 or later to support the system gcc.
# Leave empty ("") to skip setting it.
cuda_home_sglang = "/usr/local/cuda-12.5"

# Which GPUs to expose to server processes (CUDA_VISIBLE_DEVICES).
# "" → derive automatically: "0,1,...,N-1" where N = pipeline_parallel below.
# Example: "0,1,2,3" to restrict to the first four GPUs.
cuda_visible_devices = ""


[gpu]

# Number of GPUs to use for vLLM pipeline parallelism.
# 0 = auto-detect via NVML at startup.
# Set explicitly if auto-detection is unreliable in your environment.
pipeline_parallel = 0


[memory]

# Ceiling for a server's host-RAM prompt cache (llama.cpp --cache-ram).
# Saved slot states are restored from it instead of re-processing long prompts
# when more conversations are active than there are server slots.  Filled on
# demand, not reserved up front.  Either a share of physical RAM ("60%") or an
# integer MiB value; -1 = unlimited, 0 = disable.  Omit to keep the server
# default (8 GiB for llama.cpp — less than one full 128K slot of a large model).
host_cache_ram = "60%"

# Host RAM a model conversion may hold.  Converting a larger model (by its size on
# disk) to GGUF spools the converted tensors to a temporary file beside the output
# instead — needed when the converter materializes tensors (e.g. DeepSeek-V4's
# repacked MXFP4 experts), at the cost of writing the output twice.  Share of
# physical RAM or integer MiB; default "50%".
convert_ram = "50%"


# ─────────────────────────────────────────────────────────────────────────────
# Storage locations
#
# Every place models are stored — network shares and local drives alike.  The
# model list shows each model's location; copy, convert and quantize can write
# to any location.  A copy keeps the model's path relative to its location root,
# so the directory layout under every root mirrors the others.
#
#   label        short name shown in the model list's Location column
#   root         directory under which models are stored
#   description  (optional) longer name shown in destination pickers
# ─────────────────────────────────────────────────────────────────────────────

[[locations]]
label       = "NAS"
root        = "/mnt/nas/ai_models"
description = "NAS (ai_models)"

[[locations]]
label       = "NVMe"
root        = "~/fast_models"
description = "NVMe (fast_models)"

[[locations]]
label       = "SATA"
root        = "/mnt/sda1/models"
description = "SATA SSD (sda1)"


# ─────────────────────────────────────────────────────────────────────────────
# Port overrides  (optional)
#
# Default ports are defined in data.py.  Override any server's port here.
# Key is the server ID as it appears in data.py SERVERS list.
# Omit keys to keep the defaults.
# ─────────────────────────────────────────────────────────────────────────────

[ports]
# vllm     = 5000
# llamacpp = 5000
# tabby    = 5000
# ooba     = 5000      # API port
# ooba_webui = 7860    # Gradio WebUI port (separate from the API port)
# sglang   = 5000
# comfyui  = 8188
