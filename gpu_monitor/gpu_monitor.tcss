/* gpu_monitor.tcss */

Screen {
    background: $surface;
}

Header {
    background: $primary-darken-2;
}

Footer {
    background: $primary-darken-2;
}

#gpu-table {
    height: 1fr;
    margin: 0 1;
}

#status-bar {
    height: 1;
    margin: 0 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}
